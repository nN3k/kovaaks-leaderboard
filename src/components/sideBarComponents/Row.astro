---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  label: string;
  icon?: ImageMetadata;
}

const { href, label, icon } = Astro.props;
const currentPath = Astro.url.pathname;


const isActive = currentPath === href || currentPath === href + '/';
---

<a 
    href={href}
    class:list={[
        "sidebar-row",
        { "active": isActive }
    ]}
    >

    {icon && (
        <Image 
        src={icon} 
        alt={`${label} icon`}
        class="icon"
        />
    )}
    
    <span>{label}</span>
</a>