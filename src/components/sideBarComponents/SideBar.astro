---
import "../../styles/sideBar.css"
import "./Row.astro"
import Row from "./Row.astro"

import astroIcon from "../../assets/astro.svg";

const navItems = [
    { href: '/', label: 'Scenarios', icon: astroIcon },
    { href: '/playersearch', label: 'Player Search', icon: astroIcon },
    { href: '/playlists', label: 'Playlists', icon: astroIcon },
    { href: '/benchmarks', label: 'Benchmarks', icon: astroIcon },
    { href: '/profile', label: 'Profile', icon: astroIcon },
];
---


<aside class="sidebar-container">
    <nav class="sidebar">
        {navItems.map(item => (
            <Row href={item.href} label={item.label} icon={item.icon} />
        ))}
    </nav>
</aside>
