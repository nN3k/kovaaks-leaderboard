---
import Layout from '../layouts/BaseLayout.astro';
import SearchScenarioInput from '../components/listComponents/SearchScenarioInput';
import ScenarioList from '../components/listComponents/ScenarioList';
import ScoreList from '../components/listComponents/ScoreList';
import ScoreListName from '../components/listComponents/ScoreListName';
import ToggleLeaderboard from '../components/utils/ToggleLeaderboard';

---

<Layout>
	<div class="innerGrid">
		<div class="searchScenarioBundle">
			<SearchScenarioInput client:load/>
			<ScenarioList client:load/>
		</div>
		<div>
			<div class="leaderboardInfo">
				<ScoreListName client:load/>
				<ToggleLeaderboard client:load/>
			</div>
			<ScoreList client:load/>
		</div>
	</div>
</Layout>
